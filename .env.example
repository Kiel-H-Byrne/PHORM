# --- Firebase web app (public; safe to expose) ---
NEXT_PUBLIC_FSDB_KEY=
NEXT_PUBLIC_FSDB_AUTH_URI=            # e.g. your-project.firebaseapp.com
NEXT_PUBLIC_FSDB_PROJECT_ID=
NEXT_PUBLIC_FSDB_STORAGE_BUCKET=
NEXT_PUBLIC_FSDB_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FSDB_APP_ID=
NEXT_PUBLIC_FSDB_MEASUREMENT_ID=      # enables Google Analytics events
# Optional override. Defaults: "phorm-db-prod" when NODE_ENV=production, "(default)" otherwise.
# NEXT_PUBLIC_FSDB_DATABASE_ID=

# --- Firebase Admin (SERVER ONLY — never prefix with NEXT_PUBLIC_) ---
# From a service account JSON: project_id, client_email, private_key.
# Paste the private key with literal \n sequences.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_KEY=          # browser key, restrict by HTTP referrer
GOOGLE_GEOCODING_KEY=                 # server key for scripts/import-listings.js (Geocoding API, no referrer restriction)

# --- Site ---
NEXT_PUBLIC_SITE_URL=                 # e.g. https://phorm.example.com (used for share links / previews)
NEXT_PUBLIC_SUPPORT_EMAIL=            # shown as "report a problem / claim this business" on listings
